{
  "name": "platform-academy-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "export:static-api": "cd ../.. && PYTHONPATH=apps/api uv run --no-sync python scripts/export_platform_academy_static_api.py",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "smoke:routes": "node scripts/smoke-routes.mjs",
    "test": "NODE_ENV=test vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.7"
  }
}
