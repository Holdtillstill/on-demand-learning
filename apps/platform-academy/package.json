{
  "name": "platform-academy-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "check:reference-static-api": "node scripts/check-reference-static-api.mjs",
    "export:static-api": "cd ../.. && PYTHONPATH=apps/api uv run --no-sync python scripts/export_platform_academy_static_api.py && cd apps/platform-academy && node scripts/sync-reference-static-api.mjs",
    "sync:reference-static-api": "node scripts/sync-reference-static-api.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "smoke:browser-static-host": "node scripts/smoke-browser-static-host.mjs",
    "smoke:routes": "node scripts/smoke-routes.mjs",
    "smoke:static-host": "node scripts/smoke-static-host.mjs",
    "test": "NODE_ENV=test vitest run",
    "validate:figma-ui": "node scripts/validate-figma-ui.mjs",
    "validate:static-spa-router": "node scripts/validate-static-spa-router.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.2",
    "@vitejs/plugin-react": "^6.0.3",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "typescript": "~6.0.3",
    "vite": "^8.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.9"
  }
}
