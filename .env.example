APP_NAME=platform-academy-api
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://platform_academy:platform_academy@postgres:5432/platform_academy
REDIS_URL=redis://redis:6379/0
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
CORS_ORIGINS=http://localhost:5174,http://localhost:8090,http://127.0.0.1:5174,http://127.0.0.1:8090
AUTO_SEED=true
CREATE_SCHEMA_ON_STARTUP=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_EXEMPT_PATHS=/healthz,/readyz,/metrics
TRUSTED_PROXY_CIDRS=
PLATFORM_SOURCE_BUNDLE_PUBLIC=false
PLATFORM_SOURCE_BUNDLE_TOKEN=
WORKER_INTERVAL_SECONDS=30
PLATFORM_API_UPSTREAM=http://api:8000
VITE_API_BASE_URL=
